+int vtest_server_present_ahb(uint32_t res_id, void *ahb,
+                              uint32_t width, uint32_t height)
+{
+   struct vtest_present_request *request = calloc(1, sizeof(*request));
+   if (!request)
+      return -1;
+   request->res_id = res_id;
+   request->ahb = ahb;
+   request->width = width;
+   request->height = height;
+   request->status = -1;
+   pthread_mutex_init(&request->lock, NULL);
+   pthread_cond_init(&request->cond, NULL);
+
+   pthread_mutex_lock(&server.present_lock);
+   request->next = server.present_requests;
+   server.present_requests = request;
+   pthread_mutex_unlock(&server.present_lock);
+   (void)write(server.present_pipe[1], "p", 1);
+
+   pthread_mutex_lock(&request->lock);
+   while (!request->done)
+      pthread_cond_wait(&request->cond, &request->lock);
+   pthread_mutex_unlock(&request->lock);
+
+   int status = request->status;
+   pthread_cond_destroy(&request->cond);
+   pthread_mutex_destroy(&request->lock);
+   free(request);
+   return status;
+}
+
+static void vtest_server_dispatch_presents(void)
+{
+   char drain[64];
+   while (read(server.present_pipe[0], drain, sizeof(drain)) > 0)
+      ;
+
+   for (;;) {
+      struct vtest_present_request *request;
+      pthread_mutex_lock(&server.present_lock);
+      request = server.present_requests;
+      if (request)
+         server.present_requests = request->next;
+      pthread_mutex_unlock(&server.present_lock);
+      if (!request)
+         break;
+
+      int status = -1;
+      struct vtest_client *client;
+      LIST_FOR_EACH_ENTRY(client, &server.active_clients, head) {
+         if (!client->context)
+            continue;
+         vtest_set_current_context(client->context);
+         status = virgl_renderer_present_ahb_current(request->res_id,
+                                                     request->ahb,
+                                                     request->width,
+                                                     request->height);
+         if (status == 0)
+            break;
+      }
+
+      pthread_mutex_lock(&request->lock);
+      request->status = status;
+      request->done = true;
+      pthread_cond_signal(&request->cond);
+      pthread_mutex_unlock(&request->lock);
+   }
+}
