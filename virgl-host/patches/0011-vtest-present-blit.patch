 #define EGL_EGLEXT_PROTOTYPES
+#include <epoxy/gl.h>
 #include <errno.h>
 #include <fcntl.h>
 #ifdef WIN32
@@ -1025,3 +1026,70 @@
 
 /* Copy a virgl texture into an Android AHardwareBuffer.  The AHB must already
  * be imported by the caller.  Runs on the caller's current EGL context. */
+int virgl_egl_present_ahb(struct virgl_egl *egl, uint32_t tex_id, uint32_t target,
+                          void *ahb, uint32_t width, uint32_t height)
+{
+   if (!egl || !tex_id || !ahb || !width || !height)
+      return -1;
+
+#ifndef EGL_NATIVE_BUFFER_ANDROID
+#define EGL_NATIVE_BUFFER_ANDROID 0x3140
+#endif
+
+   typedef void *(*get_native_buffer_fn)(const void *);
+   typedef void (*image_target_fn)(unsigned int, void *);
+   get_native_buffer_fn get_buffer =
+      (get_native_buffer_fn)eglGetProcAddress("eglGetNativeClientBufferANDROID");
+   image_target_fn image_target =
+      (image_target_fn)eglGetProcAddress("glEGLImageTargetTexture2DOES");
+   fprintf(stderr, "present egl: get=%p target=%p egl=%p\n",
+           (void *)get_buffer, (void *)image_target, (void *)egl);
+   if (!get_buffer || !image_target)
+      return -1;
+
+   EGLClientBuffer client = get_buffer(ahb);
+   fprintf(stderr, "present egl: client=%p\n", (void *)client);
+   if (!client)
+      return -1;
+
+   const EGLint attrs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+   EGLImageKHR image = eglCreateImageKHR(egl->egl_display, EGL_NO_CONTEXT,
+         EGL_NATIVE_BUFFER_ANDROID, client, attrs);
+   fprintf(stderr, "present egl: image=%p err=0x%x\n", (void *)image, eglGetError());
+   if (image == EGL_NO_IMAGE_KHR)
+      return -1;
+
+   GLuint ahb_tex = 0;
+   GLuint fbo = 0;
+   glGenTextures(1, &ahb_tex);
+   glBindTexture(GL_TEXTURE_2D, ahb_tex);
+   image_target(GL_TEXTURE_2D, image);
+   if (glGetError() != GL_NO_ERROR) {
+      eglDestroyImageKHR(egl->egl_display, image);
+      glDeleteTextures(1, &ahb_tex);
+      return -1;
+   }
+
+   glGenFramebuffers(1, &fbo);
+   glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          target, tex_id, 0);
+   if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+      glBindFramebuffer(GL_FRAMEBUFFER, 0);
+      glDeleteFramebuffers(1, &fbo);
+      glDeleteTextures(1, &ahb_tex);
+      eglDestroyImageKHR(egl->egl_display, image);
+      return -1;
+   }
+
+   glBindTexture(GL_TEXTURE_2D, ahb_tex);
+   glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0,
+                       (GLsizei)width, (GLsizei)height);
+   glFinish();
+
+   glBindFramebuffer(GL_FRAMEBUFFER, 0);
+   glDeleteFramebuffers(1, &fbo);
+   glDeleteTextures(1, &ahb_tex);
+   eglDestroyImageKHR(egl->egl_display, image);
+   return 0;
+}
