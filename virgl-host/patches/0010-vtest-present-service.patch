--- /dev/null
+++ b/vtest/vtest_present.c
@@ -0,0 +1,142 @@
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "vtest_present.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#ifdef __ANDROID__
+#include <android/hardware_buffer.h>
+#include <dlfcn.h>
+
+#define VTEST_PRESENT_MAGIC 0x54564750u
+
+struct vtest_present_header {
+   uint32_t magic;
+   uint32_t ino;
+   uint32_t res_id;
+   uint32_t width;
+   uint32_t height;
+   uint32_t format;
+   uint32_t stride;
+};
+
+typedef int (*recv_handle_fn)(int socket_fd, AHardwareBuffer **out_buffer);
+typedef void (*describe_fn)(const AHardwareBuffer *buffer, AHardwareBuffer_Desc *desc);
+typedef void (*release_fn)(AHardwareBuffer *buffer);
+
+static void *present_thread(void *arg)
+{
+   char *path = arg;
+   int listen_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   if (listen_fd < 0) {
+      perror("vtest present: socket");
+      free(path);
+      return NULL;
+   }
+
+   struct sockaddr_un addr;
+   memset(&addr, 0, sizeof(addr));
+   addr.sun_family = AF_UNIX;
+   snprintf(addr.sun_path, sizeof(addr.sun_path), "%s", path);
+   unlink(path);
+   if (bind(listen_fd, (struct sockaddr *)&addr, sizeof(addr)) != 0 ||
+       listen(listen_fd, 4) != 0) {
+      perror("vtest present: bind/listen");
+      close(listen_fd);
+      free(path);
+      return NULL;
+   }
+   chmod(path, 0666);
+   fprintf(stderr, "vtest present: listening on %s\n", path);
+   free(path);
+
+   void *libandroid = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+   recv_handle_fn recv_handle = libandroid
+      ? (recv_handle_fn)dlsym(libandroid, "AHardwareBuffer_recvHandleFromUnixSocket")
+      : NULL;
+   describe_fn describe = libandroid
+      ? (describe_fn)dlsym(libandroid, "AHardwareBuffer_describe")
+      : NULL;
+   release_fn release = libandroid
+      ? (release_fn)dlsym(libandroid, "AHardwareBuffer_release")
+      : NULL;
+   if (!recv_handle || !describe || !release) {
+      fprintf(stderr, "vtest present: AHardwareBuffer helpers unavailable\n");
+      close(listen_fd);
+      return NULL;
+   }
+
+   for (;;) {
+      int client_fd = accept4(listen_fd, NULL, NULL, SOCK_CLOEXEC);
+      if (client_fd < 0)
+         continue;
+
+      struct vtest_present_header header;
+      ssize_t received;
+      do {
+         received = recv(client_fd, &header, sizeof(header), MSG_WAITALL);
+      } while (received < 0 && errno == EINTR);
+
+      if (received == (ssize_t)sizeof(header) &&
+          header.magic == VTEST_PRESENT_MAGIC) {
+         AHardwareBuffer *buffer = NULL;
+         int result = recv_handle(client_fd, &buffer);
+         if (result == 0 && buffer) {
+            AHardwareBuffer_Desc desc;
+            describe(buffer, &desc);
+            fprintf(stderr,
+                    "vtest present: ino=%u res_id=%u imported AHB %ux%u fmt=0x%x usage=0x%llx\n",
+                    header.ino, header.res_id, desc.width, desc.height,
+                    desc.format, (unsigned long long)desc.usage);
+            release(buffer);
+         } else {
+            fprintf(stderr, "vtest present: recv handle failed: %d\n", result);
+         }
+      }
+      close(client_fd);
+   }
+   return NULL;
+}
+
+void vtest_present_start(const char *vtest_socket_path)
+{
+   if (!vtest_socket_path || !*vtest_socket_path)
+      return;
+
+   const char *slash = strrchr(vtest_socket_path, '/');
+   size_t directory_length = slash ? (size_t)(slash - vtest_socket_path) : 0;
+   const char *name = "present.sock";
+   size_t length = directory_length + 1 + strlen(name) + 1;
+   char *path = malloc(length);
+   if (!path)
+      return;
+   if (slash)
+      snprintf(path, length, "%.*s/%s", (int)directory_length,
+               vtest_socket_path, name);
+   else
+      snprintf(path, length, "%s", name);
+
+   pthread_t thread;
+   if (pthread_create(&thread, NULL, present_thread, path) != 0) {
+      free(path);
+      return;
+   }
+   pthread_detach(thread);
+}
+#else
+void vtest_present_start(const char *vtest_socket_path)
+{
+   (void)vtest_socket_path;
+}
+#endif
--- /dev/null
+++ b/vtest/vtest_present.h
@@ -0,0 +1,8 @@
+#ifndef VTEST_PRESENT_H
+#define VTEST_PRESENT_H
+
+/* Starts a small control socket next to the vtest socket.  The host uses it to
+ * hand over the AHardwareBuffer that backs a guest token. */
+void vtest_present_start(const char *vtest_socket_path);
+
+#endif
