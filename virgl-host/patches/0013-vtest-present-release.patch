+{
+   pthread_mutex_lock(&present_state_lock);
+   for (struct vtest_present_state *state = present_states; state;
+        state = state->next) {
+      if (state->res_id == res_id) {
+         state->in_use = false;
+         pthread_cond_broadcast(&present_state_cond);
+         break;
+      }
+   }
+   pthread_mutex_unlock(&present_state_lock);
+}
