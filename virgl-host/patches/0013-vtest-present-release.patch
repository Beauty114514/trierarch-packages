+struct vtest_present_state
+{
+   uint32_t res_id;
+   bool in_use;
+   struct vtest_present_state *next;
+};
+
+static pthread_mutex_t present_state_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t present_state_cond = PTHREAD_COND_INITIALIZER;
+static struct vtest_present_state *present_states;
+
+static void vtest_server_present_acquire(uint32_t res_id)
+{
+   struct timespec deadline;
+   clock_gettime(CLOCK_REALTIME, &deadline);
+   deadline.tv_nsec += 500000000L;
+   if (deadline.tv_nsec >= 1000000000L) {
+      deadline.tv_sec++;
+      deadline.tv_nsec -= 1000000000L;
+   }
+
+   pthread_mutex_lock(&present_state_lock);
+   struct vtest_present_state *state;
+   for (state = present_states; state; state = state->next) {
+      if (state->res_id == res_id)
+         break;
+   }
+   if (!state) {
+      state = calloc(1, sizeof(*state));
+      if (state) {
+         state->res_id = res_id;
+         state->next = present_states;
+         present_states = state;
+      }
+   }
+   if (state) {
+      while (state->in_use) {
+         int rc = pthread_cond_timedwait(&present_state_cond,
+                                         &present_state_lock, &deadline);
+         if (rc == ETIMEDOUT) {
+            fprintf(stderr, "vtest present: release timeout res_id=%u\n", res_id);
+            state->in_use = false;
+            break;
+         }
+      }
+      state->in_use = true;
+   }
+   pthread_mutex_unlock(&present_state_lock);
+}
+
