+static uint32_t
+virgl_vtest_resource_get_storage_size(struct virgl_winsys *vws,
+                                      struct virgl_hw_res *res)
+{
+   (void)vws;
+   return res && res->size > 0 ? (uint32_t)res->size : 0;
+}
