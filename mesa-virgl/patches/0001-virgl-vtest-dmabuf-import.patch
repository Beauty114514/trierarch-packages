+/* The compositor creates its swapchain image from a dma-buf fd.  With the
+ * virpipe winsys there is no host-side import path for that fd, so create a
+ * regular virgl texture with the requested geometry instead.  The fd is only
+ * an identity token for the host and is not consumed here. */
+static struct virgl_hw_res *
+virgl_vtest_resource_create_from_handle(struct virgl_winsys *vws,
+                                        struct winsys_handle *whandle,
+                                        struct pipe_resource *templ,
+                                        uint32_t *plane,
+                                        uint32_t *stride,
+                                        uint32_t *plane_offset,
+                                        uint64_t *modifier,
+                                        uint32_t *blob_mem)
+{
+   if (!templ)
+      return NULL;
+
+   uint32_t lstride = util_format_get_stride(templ->format, templ->width0);
+   uint32_t size = lstride * util_format_get_nblocksy(templ->format,
+                                                      templ->height0);
+   struct virgl_hw_res *res =
+      virgl_vtest_winsys_resource_create(vws, templ->target, NULL,
+                                         templ->format,
+                                         virgl_vtest_bind_from_pipe(templ->bind),
+                                         templ->width0, templ->height0,
+                                         templ->depth0, templ->array_size,
+                                         templ->last_level, templ->nr_samples,
+                                         0, size);
+   if (!res)
+      return NULL;
+
+   trierarch_tvg_register_token(whandle ? (int)whandle->handle : -1,
+                                res->res_handle);
+
+   *plane = 0;
+   *stride = lstride;
+   *plane_offset = 0;
+   *modifier = 0;
+   *blob_mem = 0;
+   return res;
+}
