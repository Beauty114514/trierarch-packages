+#define TRIERARCH_TVG_MAGIC 0x54564731u
+#define TRIERARCH_TVG_REQUEST_REGISTER 1u
+
+struct trierarch_tvg_register {
+   uint32_t magic;
+   uint32_t type;
+   uint32_t width;
+   uint32_t height;
+   uint32_t format;
+   uint32_t stride;
+   uint32_t usage;
+   uint64_t inode;
+   uint32_t res_id;
+};
+
+/* Tell the host token service which virgl resource backs this token inode.
+ * The control socket is shared with the guest GBM shim. */
+static void
+trierarch_tvg_register_token(int fd, uint32_t res_id)
+{
+   const char *path = getenv("TRIERARCH_TVG_SOCKET");
+   if (!path || !*path || fd < 0)
+      return;
+
+   struct stat st;
+   if (fstat(fd, &st) != 0)
+      return;
+
+   int sock = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   if (sock < 0)
+      return;
+
+   struct sockaddr_un addr;
+   memset(&addr, 0, sizeof(addr));
+   addr.sun_family = AF_UNIX;
+   snprintf(addr.sun_path, sizeof(addr.sun_path), "%s", path);
+   if (connect(sock, (struct sockaddr *)&addr, sizeof(addr)) == 0) {
+      struct trierarch_tvg_register request;
+      memset(&request, 0, sizeof(request));
+      request.magic = TRIERARCH_TVG_MAGIC;
+      request.type = TRIERARCH_TVG_REQUEST_REGISTER;
+      request.inode = (uint64_t)st.st_ino;
+      request.res_id = res_id;
+      (void)send(sock, &request, sizeof(request), MSG_NOSIGNAL);
+   }
+   close(sock);
+}
