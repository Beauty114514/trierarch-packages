+static uint32_t
+virgl_vtest_bind_from_pipe(uint32_t pbind)
+{
+   uint32_t vbind = 0;
+
+   if (pbind & PIPE_BIND_DEPTH_STENCIL)
+      vbind |= VIRGL_BIND_DEPTH_STENCIL;
+   if (pbind & PIPE_BIND_RENDER_TARGET)
+      vbind |= VIRGL_BIND_RENDER_TARGET;
+   if (pbind & PIPE_BIND_SAMPLER_VIEW)
+      vbind |= VIRGL_BIND_SAMPLER_VIEW;
+   if (pbind & PIPE_BIND_DISPLAY_TARGET)
+      vbind |= VIRGL_BIND_DISPLAY_TARGET;
+   if (pbind & PIPE_BIND_SCANOUT)
+      vbind |= VIRGL_BIND_SCANOUT;
+   if (pbind & PIPE_BIND_SHARED)
+      vbind |= VIRGL_BIND_SHARED;
+   if (pbind & PIPE_BIND_CURSOR)
+      vbind |= VIRGL_BIND_CURSOR;
+   if (pbind & PIPE_BIND_CUSTOM)
+      vbind |= VIRGL_BIND_CUSTOM;
+   return vbind;
+}
+
+/* The compositor creates its swapchain image from a dma-buf fd.  With the
+ * virpipe winsys there is no host-side import path for that fd, so create a
+ * regular virgl texture with the requested geometry instead.  The fd is only
+ * an identity token for the host and is not consumed here. */
+static struct virgl_hw_res *
+virgl_vtest_resource_create_from_handle(struct virgl_winsys *vws,
+                                        struct winsys_handle *whandle,
+                                        struct pipe_resource *templ,
+                                        uint32_t *plane,
+                                        uint32_t *stride,
+                                        uint32_t *plane_offset,
+                                        uint64_t *modifier,
+                                        uint32_t *blob_mem)
+{
+   (void)whandle;
+   if (!templ)
+      return NULL;
+
+   uint32_t lstride = util_format_get_stride(templ->format, templ->width0);
+   uint32_t size = lstride * util_format_get_nblocksy(templ->format,
+                                                      templ->height0);
+   struct virgl_hw_res *res =
+      virgl_vtest_winsys_resource_create(vws, templ->target, NULL,
+                                         templ->format,
+                                         virgl_vtest_bind_from_pipe(templ->bind),
+                                         templ->width0, templ->height0,
+                                         templ->depth0, templ->array_size,
+                                         templ->last_level, templ->nr_samples,
+                                         0, size);
+   if (!res)
+      return NULL;
+
+   *plane = 0;
+   *stride = lstride;
+   *plane_offset = 0;
+   *modifier = 0;
+   *blob_mem = 0;
+   return res;
+}
+
+static uint32_t
+virgl_vtest_resource_get_storage_size(struct virgl_winsys *vws,
+                                      struct virgl_hw_res *res)
+{
+   (void)vws;
+   return res && res->size > 0 ? (uint32_t)res->size : 0;
+}
